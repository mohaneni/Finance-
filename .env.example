# GEMINI_API_KEY: Optional AI Studio environment variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted (used in sitemap, canonical URLs, email links)
APP_URL="http://localhost:3000"

# OWNER_EMAIL: Finance owner email where all new loan enquiries are delivered
OWNER_EMAIL="TODO_owner@moneylinefinance.in"

# SUPABASE (Optional — falls back to local /data/leads.json if omitted in dev)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# EMAIL DELIVERY: Resend primary, Nodemailer SMTP fallback
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Money Line Finance <enquiries@moneylinefinance.in>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Money Line Finance <enquiries@moneylinefinance.in>"

# ADMIN DASHBOARD AUTH
# Set a strong admin password (hashed/timing-safe verified server-side) and cookie secret
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="replace-with-32-char-random-secret"

# CLOUDFLARE TURNSTILE (Optional anti-bot widget on /apply)
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# FEATURE FLAGS
VITE_ENABLE_MOBILE_OTP="false"
VITE_ANALYTICS_PROVIDER=""
VITE_GA4_ID=""
VITE_PLAUSIBLE_DOMAIN=""
